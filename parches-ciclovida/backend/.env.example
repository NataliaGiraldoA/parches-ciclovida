# Copia este archivo como ".env" (queda ignorado por git) y completa lo que uses.

# --- Bot de Telegram ---------------------------------------------------------
# 1. En Telegram habla con @BotFather, manda /newbot y sigue los pasos.
# 2. Pega aquí el token que te da. El nombre de usuario del bot se detecta solo.
TELEGRAM_TOKEN=
# Opcional: solo si quieres fijarlo a mano (sin @). Si lo dejas vacío, se consulta con getMe.
TELEGRAM_BOT=

# --- Bot conversacional (Gemini) ----------------------------------------------
# Con la key, el bot entiende texto libre ("quiero trotar el domingo temprano").
# Sácala en https://aistudio.google.com/apikey. Sin key, el bot funciona con comandos y botones.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_RESPALDO=gemini-3.5-flash,gemini-flash-latest

# --- Correo institucional (opcional: sin esto, la demo muestra el código) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CORREO_DEMO=0

# --- Otros -------------------------------------------------------------------
# ADMIN_KEY=dedsec-demo
# SECRETO=cambia-esto-en-un-piloto
# ESPERA_MINUTOS=10
