{
  "version": 2,
  "buildCommand": "bash parches-ciclovida/app/tool/vercel_build.sh",
  "outputDirectory": "parches-ciclovida/app/build/web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
