{
  "version": 2,
  "buildCommand": "sh ./parches-ciclovida/app/tool/vercel_build.sh",
  "outputDirectory": "parches-ciclovida/app/build/web",
  "functions": {
    "api/index.py": {
      "includeFiles": "parches-ciclovida/backend/static/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/tablero",
      "destination": "/api/index.py"
    },
    {
      "source": "/tablero/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
