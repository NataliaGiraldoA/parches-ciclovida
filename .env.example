# Variables para Vercel. No pongas secretos reales en este archivo.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST.neon.tech/NOMBRE_BASE?sslmode=require
SEMBRAR_AL_INICIAR=1
ADMIN_KEY=REEMPLAZA_CON_UNA_CLAVE_ADMIN
SECRETO=REEMPLAZA_CON_UN_SECRETO_LARGO
CRON_SECRET=REEMPLAZA_CON_OTRO_SECRETO_LARGO
# Opcional: si se deja vacío, se deriva de TELEGRAM_TOKEN
TELEGRAM_WEBHOOK_SECRET=
FLUTTER_VERSION=3.38.9
TELEGRAM_TOKEN=
# Opcional, con o sin @. Si se deja vacío, se le pregunta a Telegram
TELEGRAM_BOT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RESPALDO=gemini-3.5-flash,gemini-flash-latest
SCHEDULER=0
RELLENAR_CON_SIMULADOS=1
CLIMA=1
CORREO_DEMO=1
